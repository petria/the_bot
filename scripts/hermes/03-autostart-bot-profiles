#!/command/with-contenv sh
# shellcheck shell=sh
#
# Auto-start configured bot Hermes profile gateways on container boot.
# Upstream reconcile recreates profile service registrations but does not
# reliably bring our bot-facing gateways back after a plain container restart.

set -eu

HERMES_HOME="${HERMES_HOME:-/opt/data}"
profiles="${BOT_HERMES_AUTOSTART_PROFILES:-}"
LOG_OUT="${LOG_OUT:-/proc/1/fd/1}"
LOG_ERR="${LOG_ERR:-/proc/1/fd/2}"

if [ -z "$profiles" ] && [ -d "$HERMES_HOME/profiles" ]; then
  profiles="$(find "$HERMES_HOME/profiles" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | grep -v '^default$' | paste -sd, -)"
fi

[ -n "$profiles" ] || exit 0

OLD_IFS="$IFS"
IFS=','
set -- $profiles
IFS="$OLD_IFS"

(
  for profile in "$@"; do
    profile="$(printf '%s' "$profile" | tr -d '[:space:]')"
    [ -n "$profile" ] || continue
    [ -d "$HERMES_HOME/profiles/$profile" ] || continue

    service_dir="/run/service/gateway-$profile"
    ready=0
    i=0
    while [ "$i" -lt 100 ]; do
      if [ -e "$service_dir/supervise/control" ] && s6-svstat "$service_dir" >/dev/null 2>&1; then
        ready=1
        break
      fi
      i=$((i + 1))
      sleep 0.2
    done

    if [ "$ready" -ne 1 ]; then
      printf '%s\n' "[bot-hermes-autostart] warning: gateway supervisor did not become ready for $profile" >>"$LOG_ERR"
      continue
    fi

    printf '%s\n' "[bot-hermes-autostart] starting profile gateway: $profile" >>"$LOG_OUT"
    if ! s6-setuidgid hermes hermes -p "$profile" gateway start >/tmp/bot-hermes-autostart-"$profile".log 2>&1; then
      printf '%s\n' "[bot-hermes-autostart] warning: gateway start failed for $profile" >>"$LOG_ERR"
      sed -n '1,120p' /tmp/bot-hermes-autostart-"$profile".log >>"$LOG_ERR" || true
    fi
  done

  # Translate fixed requests from the shared profile volume to this
  # container's own supervisors. The manager has no Docker socket.
  while :; do
    for profile in "$@"; do
      case "$profile" in ''|*[!a-z0-9-]*) continue ;; esac
      directory="$HERMES_HOME/profiles/$profile"
      request="$directory/.the-bot-gateway-request"
      [ -f "$request" ] || continue
      command="$(timeout 1 s6-setuidgid hermes head -c 80 -- "$request" 2>/dev/null)" || continue
      read -r id operation extra <<EOF
$command
EOF
      case "$id" in *[!0-9a-f-]*|'') continue ;; esac
      [ -z "$extra" ] && [ "${#id}" -eq 36 ] || continue
      result="$directory/.the-bot-gateway-result"
      previous="$(timeout 1 s6-setuidgid hermes head -c 80 -- "$result" 2>/dev/null)" || previous=""
      [ "${previous%% *}" != "$id" ] || continue
      service_dir="/run/service/gateway-$profile"
      state=ok
      case "$operation" in
        restart) s6-svc -wr -T 12000 -r "$service_dir" || state=failed ;;
        stop) s6-svc -wD -T 12000 -d "$service_dir" || state=failed ;;
        start) s6-svc -wu -T 12000 -u "$service_dir" || state=failed ;;
        *) continue ;;
      esac
      s6-setuidgid hermes sh -eu -c '
        umask 077
        temp=$(mktemp -- "$1/.the-bot-gateway-result.XXXXXX")
        printf "%s %s\n" "$2" "$3" >"$temp"
        mv -fT -- "$temp" "$1/.the-bot-gateway-result"
      ' sh "$directory" "$id" "$state" || true
    done
    sleep 1
  done
) &

exit 0
