# Hokan Develop Instance Configuration

# Bot Instance ID
HOKAN_BOT_INSTANCE_ID=hokan-develop

# Hermes Manager Settings (Develop instance)
HERMES_MANAGER_MAIN_BASE_URL=http://ubuntu-server.local:8651
HERMES_MANAGER_DEVELOP_BASE_URL=http://ubuntu-server.local:8652
HERMES_MANAGER_TOKEN=${HERMES_MANAGER_TOKEN:-}

# Docker Compose settings
COMPOSE_PROJECT_NAME=the_bot_develop
PUID=1002
PGID=1002
HOKAN_DATA_DIR=/home/hokan/dev_the_bot
DOCKER_GID=989

# Co-hosted develop bindings on docker.local
THE_BOT_ENGINE_HOST_PORT=8101
THE_BOT_IO_HOST_PORT=8093
THE_BOT_WEB_HOST_PORT=8092
THE_BOT_WEB_BIND_ADDRESS=192.168.0.33
THE_BOT_DEBUG_HOST_IP=192.168.0.33
THE_BOT_DEBUG_HOST_PORT=5005
THE_BOT_ENGINE_CONTAINER_NAME=bot-develop-engine
THE_BOT_IO_CONTAINER_NAME=bot-develop-io
THE_BOT_WEB_CONTAINER_NAME=bot-develop-web
THE_BOT_WHATSAPP_CONTAINER_NAME=bot-develop-whatsapp

# Image tags
ENGINE_IMAGE_TAG=develop
IO_IMAGE_TAG=develop
WEB_IMAGE_TAG=develop
WHATSAPP_IMAGE_TAG=develop
HERMES_MANAGER_IMAGE_TAG=develop

# Shared remote service host mapping
HOKAN_EXTERNAL_HOST_IP=192.168.0.55

# Hermes Chat Settings (shared)
HERMES_CHAT_BASE_URL=http://ubuntu-server.local:8643
HERMES_CODER_API_KEY=${HERMES_CODER_API_KEY:-}
HERMES_AI_COMMAND_BASE_URL=http://ubuntu-server.local:8645

# Web UI settings
THE_BOT_WEB_PUBLIC_BASE_URL=https://hokandevbot.airiot.fi

# API Keys (set these in your environment)
# HERMES_MANAGER_TOKEN must match the manually deployed develop manager on ubuntu-server.local:8652.
# HERMES_MANAGER_TOKEN=
# DISCORD_SECRET=
# TELEGRAM_SECRET=
