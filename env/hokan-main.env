# Hokan Main Instance Configuration

# Bot Instance ID
HOKAN_BOT_INSTANCE_ID=hokan-main

# Hermes Manager Settings (Main instance)
HERMES_MANAGER_MAIN_BASE_URL=http://ubuntu-server.local:8651
HERMES_MANAGER_DEVELOP_BASE_URL=http://ubuntu-server.local:8652
HERMES_MANAGER_TOKEN=${HERMES_MANAGER_TOKEN:-}

# Docker Compose settings
COMPOSE_PROJECT_NAME=the_bot
PUID=1002
PGID=1002
HOKAN_DATA_DIR=/home/hokan/the_bot
DOCKER_GID=989

# Main bindings on docker.local
THE_BOT_ENGINE_HOST_PORT=8100
THE_BOT_IO_HOST_PORT=8090
THE_BOT_WEB_HOST_PORT=8091
THE_BOT_WEB_BIND_ADDRESS=0.0.0.0
THE_BOT_ENGINE_CONTAINER_NAME=bot-engine
THE_BOT_IO_CONTAINER_NAME=bot-io
THE_BOT_WEB_CONTAINER_NAME=bot-web
THE_BOT_WHATSAPP_CONTAINER_NAME=bot-whatsapp

# Image tags
ENGINE_IMAGE_TAG=main
IO_IMAGE_TAG=main
WEB_IMAGE_TAG=main
WHATSAPP_IMAGE_TAG=main
HERMES_MANAGER_IMAGE_TAG=main

# Shared remote service host mapping
HOKAN_EXTERNAL_HOST_IP=192.168.0.55

# Hermes Chat Settings (shared)
HERMES_CHAT_BASE_URL=http://ubuntu-server.local:8643
HERMES_CODER_API_KEY=${HERMES_CODER_API_KEY:-}
HERMES_AI_COMMAND_BASE_URL=http://ubuntu-server.local:8645

# Web UI settings
THE_BOT_WEB_PUBLIC_BASE_URL=http://hokan-main.local:8091

# API Keys (set these in your environment)
# HERMES_MANAGER_TOKEN must match the manually deployed main manager on ubuntu-server.local:8651.
# HERMES_MANAGER_TOKEN=
# DISCORD_SECRET=
# TELEGRAM_SECRET=
